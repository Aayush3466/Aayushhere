########################################################################
#  THE CARTOGRAPHER — ENVIRONMENT
#  COPY this file to `.env.local` (copy, don't rename — keep the template)
#  and paste your keys where marked.
#
#  With no keys at all the site still runs: it renders the CV seed and the
#  Studio falls back to browser-only editing. Supabase is what makes edits
#  permanent and shared.
########################################################################

# --- Public site URL (used for SEO / Open Graph canonical + share cards) ---
# On Vercel, set this to your real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =======================================================================
# SUPABASE — auth, database, storage
# Create a project at https://supabase.com, then Project Settings → API.
# =======================================================================
# <<< PASTE: Project URL >>>
NEXT_PUBLIC_SUPABASE_URL=
# <<< PASTE: anon / publishable key (safe for the browser) >>>
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# <<< PASTE: service_role / secret key — SERVER ONLY, never sent to the browser >>>
# Used only by `npm run setup` for provisioning and seeding. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Studio owner (optional) -------------------------------------------
# Read by `npm run setup` when creating the single admin account. Leave the
# password blank and setup generates a strong one and prints it exactly once.
STUDIO_ADMIN_EMAIL=ayushadhikari3466@gmail.com
STUDIO_ADMIN_PASSWORD=

# =======================================================================
# CONTACT EMAIL (optional) — the lighthouse "email me" form
# Free tier: https://resend.com
# Messages are ALWAYS stored in the database first, so a missing or broken
# key costs you the notification email, never the message itself.
# =======================================================================
RESEND_API_KEY=
# Where contact notifications are delivered:
CONTACT_TO_EMAIL=

# =======================================================================
# CHATBOT MODEL (optional) — set EITHER Groq or Gemini
# The compass-bot answers from your records with zero API cost (retrieval).
# A model only handles open-ended phrasing + replies in the visitor's
# language. Kept server-side, rate-limited; on any failure it falls back to
# retrieval, so the bot never goes silent.
# =======================================================================
# --- Option A: Groq (console.groq.com) ---
GROQ_API_KEY=
CHAT_MODEL=llama-3.1-8b-instant
# --- Option B: Google Gemini (aistudio.google.com/apikey) — used if set ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
